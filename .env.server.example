# Copy to .env.server. Keep keys server-side; never prefix them with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: FinchNode account-backed sandbox key. No real patient data.
FINCHNODE_API_KEY=
# Other server settings are environment variables, not read from this file:
# SPACETIME_URI=ws://127.0.0.1:3000
# SPACETIME_DATABASE=kin-local
# KIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local service bearer token is created by node server/provision.mjs.
# Hosted deployments use KIN_SERVICE_TOKEN in private server environment.
